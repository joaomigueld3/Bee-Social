{
  "testCommand": "npx vitest run --reporter=tap-flat",
  "reporter": "tap",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**"
  ],
  "srcGlobs": [
    "src/**"
  ],
  "ignoreGlobs": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".spec/**",
    "src/assets/**",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/types/index.ts",
    "src/data/events.ts",
    "src/context/FavoritesContext.tsx",
    "src/context/ThemeContext.tsx",
    "src/components/Card/Skeleton.tsx",
    "src/components/Card/Skeleton.css",
    "src/components/Card/TagItem.tsx",
    "src/pages/FavoritesPage.tsx",
    "src/pages/FavoritesPage.css",
    "src/pages/LandingPage.tsx",
    "src/pages/LandingPage.css",
    "src/styles/MainPage.css",
    "src/styles/index.css"
  ]
}
